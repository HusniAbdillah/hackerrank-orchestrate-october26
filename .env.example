# Copy to ignored .env. Deterministic execution requires none of these.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
LLM_ENABLED=false
GEMINI_MODEL=gemini-3.5-flash-lite
DEEPSEEK_MODEL=deepseek-flash
LLM_TEXT_PROVIDER=deepseek
LLM_VISION_PROVIDER=gemini
LLM_MAX_TOKENS=3072
LLM_MAX_TOOL_CALLS=6
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=60
# Conservative peak cache-miss USD rates per 1M tokens; verify for your model/tariff.
GEMINI_INPUT_USD_PER_MILLION=0.30
GEMINI_OUTPUT_USD_PER_MILLION=2.50
DEEPSEEK_INPUT_USD_PER_MILLION=0.30
DEEPSEEK_OUTPUT_USD_PER_MILLION=1.20
